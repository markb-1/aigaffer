.venv/
__pycache__/
*.egg-info/
.pytest_cache/
build/

# Secrets for the VM runner and local runs; never committed.
.env

# Worktrees for isolated feature work
.worktrees/

# A recording interrupted mid-write; the real row is renamed into place.
state/executed/.*.tmp

# A news-ledger write interrupted mid-way (write_ledger renames it into place);
# run-tick.sh does `git add state/`, so it must not be committed.
state/news/.*.tmp

# A review append interrupted mid-way (append_review renames it into place).
/.GW*.md.tmp

# A detailed write interrupted mid-way: the run's snapshot (write_snapshot)
# and the gameweek's detailed report (_write_detailed) are both renamed into
# place, and run-tick.sh adds state/ and reports/, so neither is committed.
state/detailed/.*.tmp
reports/.*.tmp

# The replay's per-decision rows name other managers' entries; local only.
/state/replay/
