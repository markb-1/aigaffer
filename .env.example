# Copy to .env (chmod 600) and fill in. scripts/run-tick.sh stands down
# while any FILL_ME remains, so delete the lines you are not using rather
# than leaving them blank-ish. The table in the README says what each is.
FPL_TEAM_ID=FILL_ME
TELEGRAM_BOT_TOKEN=FILL_ME
TELEGRAM_CHAT_ID=FILL_ME
ANTHROPIC_API_KEY=FILL_ME

# Optional: the label on this box's state commits, "self-hosted" by default.
# AIGAFFER_TICK_LABEL=vm

# Optional: where the inbox keeps its offset and locks — never the repo.
# Defaults to ~/.aigaffer.
# AIGAFFER_INBOX_DIR=
