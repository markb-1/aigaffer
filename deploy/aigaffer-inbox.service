# Copy to /etc/systemd/system/ beside aigaffer-inbox.timer and replace the
# two placeholders: the user that owns the clone, and the clone's path.
[Unit]
Description=AI Gaffer inbox (read the owner's texts, answer, record "Transfers made")
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=YOUR_USER
ExecStart=/path/to/aigaffer/scripts/inbox-tick.sh
# A what-if waits for the state lock, which the hourly tick holds for a whole
# run — up to forty minutes (aigaffer.service) — and then needs about fifteen of
# its own: two 150 s solves, the free-hit pricing and an 8-minute opinion. An
# hour covers both. A kill at the limit is caught by the inbox's marker/resume
# path anyway, so the limit is a backstop, not a correctness boundary.
TimeoutStartSec=3600
